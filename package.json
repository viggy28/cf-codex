{
  "name": "cf-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in remote Codex sessions running in Cloudflare Containers",
  "bin": {
    "cf-codex": "./cli/cf-codex.mjs"
  },
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy --secrets-file .dev.vars",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "dependencies": {
    "agents": "^0.33.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-beta.32",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
